# Directory-level PHP upload ceilings for ledger/transaction attachments.
# post_max_size must exceed upload_max_filesize so a 20 MB file plus multipart
# form fields is not discarded before Temper sees it.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 32M
</IfModule>
<IfModule php_module>
    php_value upload_max_filesize 20M
    php_value post_max_size 32M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 32M
</IfModule>


