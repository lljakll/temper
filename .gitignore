*.tar.gz
*.tar.bz2
*.tar.xz
*.zip

# Local / server user data — never commit
storage/backups/
storage/backups/**

# Transaction attachments and other uploaded files
storage/documents/**
storage/uploads/**
storage/attachments/**

# Ignore everything else in storage except committed defaults
storage/*
storage/logs/*
!storage/.gitkeep
!storage/config/
!storage/config/**
storage/config/system.json

# SQL dumps sitting anywhere
*.sql
!updates/*.sql
!**/patches/*.sql
