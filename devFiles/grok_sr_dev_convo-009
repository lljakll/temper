    updateButtonStates();
}

// Function to select a fund
function selectFund(fundId) {
    selectedFundId = fundId;
    updateButtonStates();

    // Remove selected class from all rows
    document.querySelectorAll('#fundsTable tbody tr').forEach(row => {
        row.classList.remove('table-primary');
    });

    // Add selected class to clicked row
    const selectedRow = document.querySelector(`#fundsTable tbody tr[data-id="${fundId}"]`);
    if (selectedRow) {
        selectedRow.classList.add('table-primary');
    }
}

// Function to update button states
function updateButtonStates() {
    const editBtn = document.getElementById('editFundBtn');
    const deleteBtn = document.getElementById('deleteFundBtn');
    const archiveBtn = document.getElementById('archiveFundBtn');

    if (selectedFundId) {
        editBtn.disabled = false;
        deleteBtn.disabled = false;
        archiveBtn.disabled = false;
    } else {
        editBtn.disabled = true;
        deleteBtn.disabled = true;
        archiveBtn.disabled = true;
    }
}

